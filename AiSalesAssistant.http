@AiSalesAssistant_HostAddress = http://localhost:5163

GET {{AiSalesAssistant_HostAddress}}/api/knowledge
Accept: application/json

###

# Существующая услуга
POST {{AiSalesAssistant_HostAddress}}/api/assistant
Content-Type: application/json

{
  "message": "Здравствуйте, нам нужна SEO-оптимизация сайта."
}

###

# Реальный запрос через OpenRouter (требуется Llm:ApiKey в User Secrets)
POST {{AiSalesAssistant_HostAddress}}/api/assistant
Content-Type: application/json

{
  "message": "Здравствуйте, хотим интернет-магазин. Можно ли потом подключить его к CRM?"
}

###

# Вопрос, которого нет в базе знаний
POST {{AiSalesAssistant_HostAddress}}/api/assistant
Content-Type: application/json

{
  "message": "Проводите ли вы обучение сотрудников работе с бухгалтерской программой?"
}

###

# Пустое сообщение — ожидается HTTP 400
POST {{AiSalesAssistant_HostAddress}}/api/assistant
Content-Type: application/json

{
  "message": ""
}

###
